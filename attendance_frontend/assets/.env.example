# Copy this file to the project root as ".env" (same directory as pubspec.yaml) or
# set environment variables another way for build pipelines.

# Base URL for the REST API (no trailing slash recommended)
API_BASE_URL=http://10.0.2.2:8000

# WebSocket endpoint for real-time updates
REALTIME_URL=ws://10.0.2.2:8000/ws

# If true, the app uses local mock flows where applicable
MOCK_MODE=false
