# Example environment configuration for Attendance Frontend (Flutter)
# Copy this file to `.env` at the project root (same directory) and adjust values.

# REST API base URL for the backend
# For Android emulator, 10.0.2.2 points to host machine localhost
API_BASE_URL=http://10.0.2.2:8000

# WebSocket realtime URL (used by RealtimeService)
REALTIME_URL=ws://10.0.2.2:8000/ws

# Server-Sent Events URL (fallback when WebSocket isn’t available)
EVENTS_URL=http://10.0.2.2:8000/events

# Set to false to use real backend; true will simulate responses without network calls
MOCK_MODE=false
