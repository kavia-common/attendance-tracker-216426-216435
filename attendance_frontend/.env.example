# Attendance Frontend Environment
# Set MOCK_MODE=false to use real backend. true will simulate login and data locally.
MOCK_MODE=false

# For Android emulator use 10.0.2.2; for desktop use localhost
# Replace <host> below accordingly.
# Desktop example:
# API_BASE_URL=http://localhost:3010
# REALTIME_URL=ws://localhost:3010/ws
# EVENTS_URL=http://localhost:3010/events

# Android Emulator example:
API_BASE_URL=http://10.0.2.2:3010
REALTIME_URL=ws://10.0.2.2:3010/ws
EVENTS_URL=http://10.0.2.2:3010/events

# Optional overrides if your backend uses different paths:
# AUTH_LOGIN_PATH=/auth/login
# AUTH_ME_PATHS=/users/me,/auth/me,/me,/users/profile
