# Backend endpoints (use localhost for desktop, 10.0.2.2 for Android emulator)
API_BASE_URL=http://10.0.2.2:8000
REALTIME_URL=ws://10.0.2.2:8000/ws
EVENTS_URL=http://10.0.2.2:8000/events

# Use mock mode for offline/demo. MUST be false for real backend.
MOCK_MODE=false

# Optional overrides if backend uses different auth endpoints
# Default AUTH_LOGIN_PATH=/auth/login
# Default AUTH_ME_PATHS=/users/me,/auth/me,/me,/users/profile
# AUTH_LOGIN_PATH=/api/v1/auth/login
# AUTH_ME_PATHS=/api/v1/users/me,/users/me,/auth/me

# Notes:
# - Ensure your backend CORS allows Authorization header for REST and WS.
# - Make sure backend issues a token under one of: token|access_token|accessToken|jwt|id_token
#   or nested under data./auth./meta. The frontend will auto-detect common keys.
# - After login, frontend will call the first available path in AUTH_ME_PATHS to populate user.
