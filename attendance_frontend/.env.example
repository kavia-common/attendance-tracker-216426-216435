# Copy this file to .env and adjust values for your environment.
# Make sure MOCK_MODE=false for real backend.

# Base URL for REST API (no trailing slash)
API_BASE_URL=http://10.0.2.2:8000

# WebSocket URL for realtime updates
REALTIME_URL=ws://10.0.2.2:8000/ws

# SSE fallback URL for realtime updates
EVENTS_URL=http://10.0.2.2:8000/events

# Use mock mode for frontend-only testing (no backend calls)
MOCK_MODE=false
