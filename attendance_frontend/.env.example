# API base URL for REST endpoints (use 10.0.2.2 for Android emulator)
API_BASE_URL=http://10.0.2.2:8000

# WebSocket URL for realtime (optional)
REALTIME_URL=ws://10.0.2.2:8000/ws

# SSE events URL (fallback if WS fails)
EVENTS_URL=http://10.0.2.2:8000/events

# Disable mocks for real backend testing
MOCK_MODE=false

# Optional overrides if backend uses different paths
# AUTH_LOGIN_PATH=/auth/login
# AUTH_ME_PATHS=/users/me,/auth/me,/me
