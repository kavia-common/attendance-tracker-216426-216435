# Environment configuration for Attendance Frontend (Flutter)
# Copy this file to .env at the project root (attendance_frontend) and adjust values.

# Base URL for REST API (no trailing slash)
# For Android emulator connecting to host machine backend use 10.0.2.2
API_BASE_URL=http://10.0.2.2:8000

# Realtime endpoint. If your backend exposes WebSocket at /ws, use ws://.../ws
# For HTTPS backends, use wss://
REALTIME_URL=ws://10.0.2.2:8000/ws

# When true, the app uses mock mode and will not call the backend.
# Accepts: true/false, 1/0, yes/no, on/off
MOCK_MODE=false
