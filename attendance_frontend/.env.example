# Attendance Frontend configuration
# Copy to .env and adjust as needed.

# Base URL of your backend API (without trailing slash)
API_BASE_URL=http://10.0.2.2:8000

# WebSocket URL for realtime (ws:// or wss://)
REALTIME_URL=ws://10.0.2.2:8000/ws

# Server-Sent Events (SSE) URL for events fallback
EVENTS_URL=http://10.0.2.2:8000/events

# Set to true to use mock mode (no backend calls)
MOCK_MODE=false
