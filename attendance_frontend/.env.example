# API base URL for REST endpoints
# Example for local backend:
API_BASE_URL=http://localhost:3010

# WebSocket URL for realtime updates
# Example for local backend:
REALTIME_URL=ws://localhost:3010/ws

# Server-Sent Events endpoint (if used by backend)
# Example for local backend:
EVENTS_URL=http://localhost:3010/events

# When true, the app will use local mock data instead of network
MOCK_MODE=false
