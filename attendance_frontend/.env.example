# Backend base URL (protocol + host + port), used by REST ApiClient
# For Android emulator, host.docker.internal is not available; use 10.0.2.2 to reach host
API_BASE_URL=http://10.0.2.2:8000

# Realtime WebSocket endpoint. Must be ws:// for http and wss:// for https
REALTIME_URL=ws://10.0.2.2:8000/ws

# Server-Sent Events fallback endpoint (GET text/event-stream)
EVENTS_URL=http://10.0.2.2:8000/events

# Toggle mock mode (true/false). When true, login is simulated and no backend calls are made.
MOCK_MODE=false
