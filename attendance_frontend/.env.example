# Frontend environment configuration for attendance_frontend
# Copy this file to .env and adjust values to your local/dev/staging/prod environment.

# Base REST API URL of the attendance backend (no trailing slash)
# Android emulator host=10.0.2.2 if backend runs on host machine
API_BASE_URL=http://10.0.2.2:8000

# Realtime WebSocket endpoint (JWT sent via Authorization header)
REALTIME_URL=ws://10.0.2.2:8000/ws

# Server-Sent Events fallback endpoint (JWT sent via Authorization header)
EVENTS_URL=http://10.0.2.2:8000/events

# Disable mocks for E2E testing
MOCK_MODE=false
